# App
APP_NAME=TAPTOT API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database — PostgreSQL (required for local + production)
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@localhost:5432/taptot

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Security — CHANGE IN PRODUCTION
SECRET_KEY=change-me-to-a-long-random-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
REDIS_URL=

# Frontend (password reset / email verify links)
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_EXPIRE_HOURS=1
EMAIL_VERIFY_EXPIRE_HOURS=24

# Email: console | smtp | resend
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@taptot.vn
RESEND_API_KEY=

# Số người gen lịch cùng lúc. Người thứ 6 trở đi chờ tối đa GEN_QUEUE_WAIT_SECONDS rồi nhận lỗi.
GEN_MAX_CONCURRENT=5
GEN_QUEUE_WAIT_SECONDS=60
# Reference price (matches seed pay_per_generate)
AI_GENERATE_PRICE_VND=49000

# Payments (điền sau khi đăng ký VNPay)
PAYMENT_WEBHOOK_SECRET=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# Media uploads
UPLOAD_DIR=../uploads
MAX_UPLOAD_MB=10
MEDIA_BASE_URL=http://localhost:8000/media

# OAuth — leave empty to disable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/auth/facebook/callback

# true = require product gift code for schedule generate; false = skip gate (dev/test).
REQUIRE_REDEEM_CODE_FOR_GENERATE=true

# Cloudflare Turnstile — empty secret skips verify (local/dev).
TURNSTILE_SECRET_KEY=
# TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Daily caps for free gen, Asia/Ho_Chi_Minh day.
FAM_GEN_DAILY_CAP_ENABLED=true
FAM_GEN_DAILY_IP_LIMIT=5
FAM_GEN_DAILY_DEVICE_LIMIT=3

# Shop bank transfer (VietQR) — update with real STK
SHOP_BANK_BIN=970422
SHOP_BANK_ACCOUNT=0000000000
SHOP_BANK_ACCOUNT_NAME=TAPTOT
SHOP_BANK_NAME=MB Bank

SHOP_CHECKOUT_RATE_LIMIT=10
SHOP_TRACK_RATE_LIMIT=20

# Feedback → Google Sheet (Apps Script web app). Leave empty to skip.
FEEDBACK_SHEETS_WEBHOOK_URL=
FEEDBACK_SHEETS_SECRET=

# Shop orders → Google Sheet. Same deployment URL is fine after the script
# handles kind "order". Leave empty to skip.
ORDER_SHEETS_WEBHOOK_URL=
ORDER_SHEETS_SECRET=

# --- Production (VPS + nginx) ---
# Copy to /etc/taptot/api.env (systemd EnvironmentFile). See deploy/README.md
# APP_ENV=production
# DEBUG=false
# SECRET_KEY=generate-with-python-secrets.token_urlsafe-48
# DATABASE_URL=postgresql+psycopg://taptot:PASSWORD@127.0.0.1:5432/taptot
# CORS_ORIGINS=https://taptot.vn,https://www.taptot.vn
# FRONTEND_URL=https://taptot.vn
# MEDIA_BASE_URL=https://taptot.vn/media
# UPLOAD_DIR=/var/lib/taptot/uploads
