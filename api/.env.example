# App
APP_NAME=TAPTOT API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database — PostgreSQL (required for local + production)
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@localhost:5432/taptot

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Security — CHANGE IN PRODUCTION
SECRET_KEY=change-me-to-a-long-random-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
REDIS_URL=

# Frontend (password reset / email verify links)
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_EXPIRE_HOURS=1
EMAIL_VERIFY_EXPIRE_HOURS=24

# Email: console | smtp | resend
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@taptot.vn
RESEND_API_KEY=

# AI - OpenAI (REQUIRED for workout generate — picks exercises from shortlists)
# Key: https://platform.openai.com/api-keys
# Default model: gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=90
OPENAI_TEMPERATURE=0.4
OPENAI_MAX_TOKENS=4096
# true = OpenAI chọn bài (default). false = gen lịch fail cứng (không fallback rule).
WORKOUT_GEN_USE_OPENAI=true
# Coach advice copy (optional; fails soft to fallback text)
WORKOUT_GEN_COACH_ADVICE=true
# Cổng điều tiết gọi OpenAI (chống 429 khi nhiều người gen cùng lúc).
# REDIS_URL là TÙY CHỌN: có thì điều tiết xuyên nhiều instance; không set vẫn chạy (semaphore trong process).
AI_MAX_CONCURRENT=2
AI_GATE_WAIT_SECONDS=45
AI_RETRY_ATTEMPTS=3
AI_RETRY_BASE_SECONDS=2.0
# False = unlimited AI workout gen (default). True = enforce monthly quota below.
AI_QUOTA_ENABLED=false
# Free AI gens/month — only when AI_QUOTA_ENABLED=true. Production often 0.
AI_FREE_GENERATIONS_PER_MONTH=5
# Reference price (matches seed pay_per_generate)
AI_GENERATE_PRICE_VND=49000

# Payments (điền sau khi đăng ký VNPay)
PAYMENT_WEBHOOK_SECRET=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# Media uploads
UPLOAD_DIR=../uploads
MAX_UPLOAD_MB=10
MEDIA_BASE_URL=http://localhost:8000/media

# OAuth — leave empty to disable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/auth/facebook/callback

# true = require product gift code for schedule generate; false = skip gate (dev/test).
REQUIRE_REDEEM_CODE_FOR_GENERATE=true

# --- Production (Railway) example ---
# APP_ENV=production
# DEBUG=false
# SECRET_KEY=generate-with-secrets.token_urlsafe-48
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# CORS_ORIGINS=https://taptot.vn,https://www.taptot.vn
# FRONTEND_URL=https://taptot.vn
# MEDIA_BASE_URL=https://taptot.vn/media
# UPLOAD_DIR=/data/uploads
# RATE_LIMIT_TRUST_X_FORWARDED_FOR=true
# OPENAI_API_KEY=sk-...
