# Copy to deploy/.env on the VPS. Never commit this file with real secrets.

POSTGRES_PASSWORD=change-me-long-random
SECRET_KEY=change-me-at-least-32-characters-long-random

APP_NAME=TAPTOT API
CORS_ORIGINS=https://taptot.vn,https://www.taptot.vn
FRONTEND_URL=https://taptot.vn
MEDIA_BASE_URL=https://taptot.vn/media

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
WORKOUT_GEN_USE_OPENAI=true

REQUIRE_REDEEM_CODE_FOR_GENERATE=true
NEXT_PUBLIC_REQUIRE_REDEEM_CODE=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional
RESEND_API_KEY=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://taptot.vn/auth/google/callback
