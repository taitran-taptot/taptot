# Local (npm run dev)
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000/api/v1
API_PROXY_TARGET=http://127.0.0.1:8000
NEXT_PUBLIC_REQUIRE_REDEEM_CODE=true
# Cloudflare Turnstile site key (pair with TURNSTILE_SECRET_KEY on API). Empty = skip in local.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Production on Vercel (taptot.vn) — set in the Vercel dashboard:
# NEXT_PUBLIC_API_BASE=https://api.taptot.vn/api/v1
# API_PROXY_TARGET=https://api.taptot.vn
# NEXT_PUBLIC_MEDIA_BASE=/media
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...
